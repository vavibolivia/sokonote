<UserControl x:Class="SokoNote.Controls.ColorPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="228">
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <StackPanel>
            <Button x:Name="AutoButton" Style="{StaticResource SecondaryButton}" Height="26" Margin="0,0,0,8"
                    Content="{DynamicResource S.Automatic}" Click="Auto_Click" Visibility="Collapsed"/>
            <ItemsControl x:Name="Swatches">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="22" Height="22" Margin="2" Click="Swatch_Click" Tag="{Binding}" ToolTip="{Binding}"
                                Cursor="Hand" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{Binding Converter={StaticResource HexToBrush}}" CornerRadius="4"
                                            BorderBrush="#33000000" BorderThickness="1"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink}"/>
                                            <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource S.ColorHex}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                <Button x:Name="ApplyButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="26" Padding="10,0"
                        Content="{DynamicResource S.Apply}" Click="Apply_Click" Margin="6,0,0,0"/>
                <Border x:Name="PreviewSwatch" DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="4" BorderBrush="#33000000" BorderThickness="1" Margin="6,0,0,0"/>
                <TextBox x:Name="HexBox" Style="{StaticResource InputBox}" Padding="6,3" Tag="#RRGGBB" MaxLength="9"
                         TextChanged="HexBox_TextChanged" KeyDown="HexBox_KeyDown"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
