<Window x:Class="SokoNote.Views.ClaudeWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource S.ClaudeWeb.Title}" Width="1100" Height="820" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        Icon="pack://application:,,,/SokoNote;component/Assets/app.ico"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceAlt}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{DynamicResource S.Claude.Scope}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ScopeCombo" Width="130" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="NewChatButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.ClaudeWeb.New}"
                            Click="NewChat_Click" Margin="6,0,0,0" Height="32"/>
                    <Button x:Name="InsertToEntryButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.ClaudeWeb.Insert}"
                            Click="InsertToEntry_Click" Margin="6,0,0,0" Height="32"/>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.ClaudeWeb.Send}"
                            Click="Send_Click" Margin="8,0,0,0" Height="32" IsDefault="True"/>
                    <TextBox x:Name="QuestionBox" Style="{StaticResource InputBox}" Tag="{DynamicResource S.ClaudeWeb.QuestionPlaceholder}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="2,6,0,0" TextWrapping="Wrap" Text="{DynamicResource S.ClaudeWeb.Hint}"/>
            </StackPanel>
        </Border>
        <Grid>
            <wv2:WebView2 x:Name="Browser"/>
            <TextBlock x:Name="LoadingText" Text="{DynamicResource S.ClaudeWeb.Loading}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
