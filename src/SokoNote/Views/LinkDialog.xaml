<Window x:Class="SokoNote.Views.LinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.LinkDialogTitle}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="{DynamicResource S.LinkText}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
        <TextBox x:Name="TextBox1" Style="{StaticResource InputBox}"/>
        <TextBlock Text="{DynamicResource S.LinkUrl}" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
        <TextBox x:Name="UrlBox" Style="{StaticResource InputBox}" Tag="{DynamicResource S.LinkUrlPlaceholder}"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12" Margin="2,4,0,0" Visibility="Collapsed"
                   Text="{DynamicResource S.LinkInvalid}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RemoveButton" Style="{StaticResource DangerButton}" Content="{DynamicResource S.LinkRemove}" MinWidth="80" Margin="0,0,8,0"
                    Click="Remove_Click" Visibility="Collapsed"/>
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Cancel}" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.OK}" IsDefault="True" MinWidth="80" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
