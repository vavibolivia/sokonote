<Window x:Class="SokoNote.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SokoNote"
        xmlns:views="clr-namespace:SokoNote.Views"
        xmlns:controls="clr-namespace:SokoNote.Controls"
        xmlns:vm="clr-namespace:SokoNote.ViewModels"
        xmlns:models="clr-namespace:SokoNote.Models"
        Title="{DynamicResource S.AppName}" Width="1400" Height="880" MinWidth="1040" MinHeight="620"
        Icon="pack://application:,,,/SokoNote;component/Assets/app.ico" Background="{StaticResource CanvasBg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static views:AppCommands.NewEntry}" Executed="NewEntry_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.InsertToday}" Executed="InsertToday_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.SaveEntry}" Executed="SaveEntry_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.FocusSearch}" Executed="FocusSearch_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.InsertLink}" Executed="InsertLink_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.PrevDay}" Executed="PrevDay_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.NextDay}" Executed="NextDay_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.Today}" Executed="Today_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.ToggleClaude}" Executed="ToggleClaude_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.OpenSettings}" Executed="OpenSettings_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.AddTopic}" Executed="AddTopic_Executed"/>
        <CommandBinding Command="{x:Static views:AppCommands.DeleteEntry}" Executed="DeleteEntry_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{x:Static views:AppCommands.NewEntry}"/>
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{x:Static views:AppCommands.InsertToday}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{x:Static views:AppCommands.SaveEntry}"/>
        <KeyBinding Gesture="Ctrl+F" Command="{x:Static views:AppCommands.FocusSearch}"/>
        <KeyBinding Gesture="Ctrl+K" Command="{x:Static views:AppCommands.InsertLink}"/>
        <KeyBinding Gesture="Alt+Left" Command="{x:Static views:AppCommands.PrevDay}"/>
        <KeyBinding Gesture="Alt+Right" Command="{x:Static views:AppCommands.NextDay}"/>
        <KeyBinding Gesture="Ctrl+T" Command="{x:Static views:AppCommands.Today}"/>
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{x:Static views:AppCommands.ToggleClaude}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{x:Static views:AppCommands.OpenSettings}"/>
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{x:Static views:AppCommands.AddTopic}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Context menus live here, not inside Setter.Value: the XAML compiler wires Click handlers inside
             a setter to the wrong element (connectionId mix-up → InvalidCastException when list items are created). -->
        <ContextMenu x:Key="TopicMenu">
            <MenuItem Header="{DynamicResource S.Rename}" Click="TopicRename_Click"/>
            <MenuItem Header="{DynamicResource S.ChangeColor}" Click="TopicColor_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource S.MoveUp}" Click="TopicUp_Click"/>
            <MenuItem Header="{DynamicResource S.MoveDown}" Click="TopicDown_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource S.DeleteTopic}" Click="TopicDelete_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="EntryMenu">
            <MenuItem Header="{DynamicResource S.Duplicate}" Click="EntryDuplicate_Click"/>
            <MenuItem Header="{DynamicResource S.MoveToToday}" Click="EntryMoveToday_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource S.DeleteEntry}" Click="EntryDelete_Click"/>
        </ContextMenu>

        <!-- topic row -->
        <DataTemplate x:Key="TopicTemplate" DataType="{x:Type models:Topic}">
            <DockPanel>
                <Ellipse Width="9" Height="9" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource SidebarMuted}" Margin="0,0,6,0"
                           VerticalAlignment="Center" ToolTip="{DynamicResource S.TopicKindInfo}" Visibility="{Binding IsInfo, Converter={StaticResource BoolToVis}}"/>
                <Border DockPanel.Dock="Right" Background="#2A3148" CornerRadius="9" Padding="7,1" MinWidth="22" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EntryCount}" FontSize="11" Foreground="{StaticResource SidebarMuted}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13"/>
            </DockPanel>
        </DataTemplate>

        <Style x:Key="TopicItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource TopicItem}">
            <Setter Property="ContextMenu" Value="{StaticResource TopicMenu}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAll}" Value="True">
                    <Setter Property="ContextMenu" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- entry card -->
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type models:Entry}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Ellipse Width="8" Height="8" Fill="{Binding TopicColor, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Right" Background="{Binding Status, Converter={StaticResource StatusSoftBrush}}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="10.5" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                    </Border>
                    <Border DockPanel.Dock="Right" Visibility="{Binding HasDate, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding EntryDate, Converter={StaticResource ShortDate}}" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.IsDateMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisInv}}"/>
                    </Border>
                    <TextBlock Text="{Binding TopicName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" Text="{Binding Title}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Title}" Value="">
                                    <Setter Property="Text" Value="{DynamicResource S.Untitled}"/>
                                    <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,3,0,0" LineHeight="17"
                           Visibility="{Binding Preview, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="EntryItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource EntryItem}">
            <Setter Property="ContextMenu" Value="{StaticResource EntryMenu}"/>
        </Style>

        <!-- chat bubble -->
        <DataTemplate x:Key="ChatTemplate" DataType="{x:Type models:ChatMessage}">
            <StackPanel Margin="0,0,0,10">
                <Border x:Name="bubble" CornerRadius="10" Padding="11,8" MaxWidth="330" HorizontalAlignment="Left" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <TextBox x:Name="text" Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource Ink}" FontSize="13" Padding="0" IsTabStop="False" Cursor="IBeam"/>
                </Border>
                <StackPanel x:Name="actions" Orientation="Horizontal" Margin="4,3,0,0" Visibility="Collapsed">
                    <Button Style="{StaticResource ToolButton}" Height="22" FontSize="11" Foreground="{StaticResource InkMuted}" Content="{DynamicResource S.Claude.Copy}" Click="ChatCopy_Click"/>
                    <Button Style="{StaticResource ToolButton}" Height="22" FontSize="11" Foreground="{StaticResource InkMuted}" Content="{DynamicResource S.Claude.InsertToEntry}" Click="ChatInsert_Click"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="bubble" Property="Background" Value="{StaticResource Accent}"/>
                    <Setter TargetName="bubble" Property="BorderThickness" Value="0"/>
                    <Setter TargetName="text" Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="bubble" Property="Background" Value="{StaticResource DangerSoft}"/>
                    <Setter TargetName="bubble" Property="BorderBrush" Value="#F0C2C2"/>
                    <Setter TargetName="text" Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                    <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RtbHyperlink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=NavigateUri}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition x:Name="ListColumn" Width="330" MinWidth="270" MaxWidth="520"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition x:Name="ClaudeColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <DockPanel Margin="12,14,12,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,14">
                    <Image Source="pack://application:,,,/SokoNote;component/Assets/app.png" Width="26" Height="26" Margin="0,0,9,0"/>
                    <TextBlock Text="{DynamicResource S.AppName}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="{DynamicResource S.SearchPlaceholder}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource SidebarMuted}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <Button Style="{StaticResource ToolButton}" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="{StaticResource SidebarMuted}"
                            Click="ClearSearch_Click" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource S.Close}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                    </Button>
                </Grid>

                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Width="26" Height="26" Foreground="{StaticResource SidebarMuted}"
                            Command="{x:Static views:AppCommands.AddTopic}" ToolTip="{DynamicResource S.AddTopic}">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                    </Button>
                    <TextBlock Text="{DynamicResource S.Topics}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SidebarMuted}" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource SidebarButton}" Click="ClaudeButton_Click" ToolTip="{DynamicResource S.Claude.Open}">
                        <DockPanel>
                            <TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Claude.Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Claude.AccountLabel}" FontSize="10.5" Foreground="{StaticResource SidebarMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{x:Static views:AppCommands.OpenSettings}" Margin="0,2,0,0">
                        <DockPanel>
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource S.Settings}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </StackPanel>

                <Grid>
                    <ListBox x:Name="TopicList" ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" ItemTemplate="{StaticResource TopicTemplate}"
                             ItemContainerStyle="{StaticResource TopicItemStyle}" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="TopicList_MouseDoubleClick"/>
                    <TextBlock Text="{DynamicResource S.NoTopicsHint}" Foreground="{StaticResource SidebarMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="10,0,10,60" LineHeight="20"
                               Visibility="{Binding RealTopics.Count, Converter={StaticResource ZeroToVis}}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================================================= entry list -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,0">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}" IsChecked="{Binding IsReadAllMode}" ToolTip="{DynamicResource S.ReadAllHint}" Padding="8,0"
                                      Visibility="{Binding IsPageMode, Converter={StaticResource BoolToVisInv}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE736;" Style="{StaticResource Icon}" Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource S.ReadAll}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Border Background="{StaticResource Line}" CornerRadius="8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource S.ByDate}" IsChecked="{Binding IsByDateView}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource S.All}" IsChecked="{Binding IsAllView}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource S.OnePage}" IsChecked="{Binding IsPageMode}" ToolTip="{DynamicResource S.OnePageHint}"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <DockPanel x:Name="DateNavPanel" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="{DynamicResource S.Today}" Command="{x:Static views:AppCommands.Today}" FontSize="12"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{x:Static views:AppCommands.PrevDay}" ToolTip="{DynamicResource S.PrevDay}">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{x:Static views:AppCommands.NextDay}" ToolTip="{DynamicResource S.NextDay}">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                        <ToggleButton x:Name="DateToggle" Style="{StaticResource ToolToggle}" ToolTip="{DynamicResource S.PickDate}" Margin="2,0" HorizontalAlignment="Stretch"
                                      IsChecked="{Binding IsOpen, ElementName=CalendarPopup, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding SelectedDateText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=DateToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Margin="8" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/>
                                </Border.Effect>
                                <Calendar x:Name="DateCalendar" CalendarDayButtonStyle="{StaticResource MarkedDayButton}" BorderThickness="0"
                                          SelectedDatesChanged="DateCalendar_SelectedDatesChanged" PreviewMouseUp="DateCalendar_PreviewMouseUp"/>
                            </Border>
                        </Popup>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,0" Visibility="{Binding IsPageMode, Converter={StaticResource BoolToVisInv}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{x:Static views:AppCommands.NewEntry}" Height="28" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource S.NewEntry}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="StatusFilter" SelectedIndex="{Binding StatusFilterIndex}" Margin="0,0,8,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,0" Visibility="{Binding IsPageMode, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{x:Static views:AppCommands.InsertToday}" Height="28" Padding="10,0"
                                ToolTip="{DynamicResource S.PageInsertTodayHint}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource S.PageInsertToday}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock/>
                    </DockPanel>

                    <TextBlock Text="{Binding ListTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="2,14,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ListSubtitle}" Style="{StaticResource Caption}" Margin="2,2,0,10"/>
                </StackPanel>

                <ListBox x:Name="PageDayList" ItemsSource="{Binding PageDays}" Background="Transparent" BorderThickness="0" Padding="14,0,14,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PageDayList_SelectionChanged"
                         Visibility="{Binding IsPageMode, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,5">
                                <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                        Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{DynamicResource S.Today}" Foreground="White" FontSize="10.5"/>
                                </Border>
                                <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource InkMuted}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Visibility="{Binding IsPageMode, Converter={StaticResource BoolToVisInv}}">
                    <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" ItemTemplate="{StaticResource EntryTemplate}"
                             ItemContainerStyle="{StaticResource EntryItemStyle}" Background="Transparent" BorderThickness="0" Padding="14,0,14,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" KeyDown="EntryList_KeyDown"/>
                    <StackPanel VerticalAlignment="Center" Margin="20,0,20,80" Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVis}}">
                        <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource InkFaint}" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource S.NoEntriesForDay}" Foreground="{StaticResource InkMuted}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource S.NoEntriesHint}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="2" Width="5" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" ShowsPreview="False" Focusable="False"/>

        <!-- ================================================= editor -->
        <Grid Grid.Column="3" Margin="0">
            <!-- empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60">
                <TextBlock Text="&#xE70B;" Style="{StaticResource Icon}" FontSize="44" Foreground="{StaticResource InkFaint}" Margin="0,0,0,14"/>
                <TextBlock Text="{DynamicResource S.NoEntrySelected}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" TextAlignment="Center"/>
                <TextBlock Text="{DynamicResource S.NoEntryHint}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,6,0,16"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.NewEntry}" Command="{x:Static views:AppCommands.NewEntry}" HorizontalAlignment="Center" Padding="18,0"/>
            </StackPanel>

            <!-- read-all -->
            <DockPanel x:Name="ReadAllPanel" Visibility="Collapsed" Margin="18,14,18,14">
                <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Print}" Click="PrintReadAll_Click" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.ExportRtf}" Click="ExportReadAll_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.ReadAllTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="{Binding ListSubtitle}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="ReadAllPaper" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <FlowDocumentScrollViewer x:Name="ReadAllViewer" VerticalScrollBarVisibility="Auto" IsSelectionEnabled="True" IsToolBarVisible="False" Zoom="100"/>
                </Border>
            </DockPanel>

            <!-- editor -->
            <DockPanel x:Name="EditorPanel" Visibility="Collapsed">
                <!-- header -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,12,16,8">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,2,0,0">
                                <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource S.Export}" Click="Export_Click">
                                    <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}"/>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource S.ExportRtf}" Click="ExportRtf_Click"/>
                                            <MenuItem Header="{DynamicResource S.ExportTxt}" Click="ExportTxt_Click"/>
                                            <Separator/>
                                            <MenuItem Header="{DynamicResource S.Print}" Click="Print_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="DeleteEntryButton" Style="{StaticResource ToolButton}" ToolTip="{DynamicResource S.DeleteEntry}" Command="{x:Static views:AppCommands.DeleteEntry}" Foreground="{StaticResource Danger}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                </Button>
                            </StackPanel>
                            <TextBox x:Name="TitleBox" Style="{StaticResource TitleBox}" Tag="{DynamicResource S.TitlePlaceholder}" MaxLength="200"
                                     Text="{Binding CurrentEntry.Title, UpdateSourceTrigger=PropertyChanged}" KeyDown="TitleBox_KeyDown"/>
                        </DockPanel>
                        <WrapPanel x:Name="EntryMetaPanel" Margin="2,6,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="{DynamicResource S.Topic}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="TopicCombo" ItemsSource="{Binding RealTopics}" SelectedValuePath="Id" MinWidth="140" SelectionChanged="TopicCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="EntryDatePanel" Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="{DynamicResource S.Date}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="EntryDatePicker" Width="150" SelectedDateChanged="EntryDatePicker_SelectedDateChanged" CalendarStyle="{x:Null}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="{DynamicResource S.Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="StatusCombo" MinWidth="110" SelectionChanged="StatusCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Converter={StaticResource StatusBrush}}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Converter={StaticResource StatusText}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="CreatedText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- toolbar -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,5">
                    <WrapPanel x:Name="Toolbar">
                        <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Undo}">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Redo}">
                            <TextBlock Text="&#xE7A6;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Border Style="{StaticResource Separator}"/>

                        <ComboBox x:Name="FontCombo" IsEditable="True" Width="160" ToolTip="{DynamicResource S.Font}" DropDownClosed="FontCombo_DropDownClosed"
                                  KeyDown="FontCombo_KeyDown" LostKeyboardFocus="FontCombo_LostKeyboardFocus" IsTextSearchEnabled="True" StaysOpenOnEdit="True">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="14"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="SizeCombo" IsEditable="True" Width="64" Margin="4,0,0,0" ToolTip="{DynamicResource S.FontSize}" DropDownClosed="SizeCombo_DropDownClosed"
                                  KeyDown="SizeCombo_KeyDown" LostKeyboardFocus="SizeCombo_LostKeyboardFocus"/>
                        <Border Style="{StaticResource Separator}"/>

                        <ToggleButton x:Name="BoldBtn" Style="{StaticResource ToolToggle}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Bold}" FontWeight="Bold" Content="B" FontSize="14"/>
                        <ToggleButton x:Name="ItalicBtn" Style="{StaticResource ToolToggle}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Italic}" FontStyle="Italic" Content="I" FontSize="14" FontFamily="Georgia, Times New Roman"/>
                        <ToggleButton x:Name="UnderlineBtn" Style="{StaticResource ToolToggle}" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Underline}" FontSize="14">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </ToggleButton>
                        <ToggleButton x:Name="StrikeBtn" Style="{StaticResource ToolToggle}" Click="Strike_Click" ToolTip="{DynamicResource S.Strike}" FontSize="14">
                            <TextBlock Text="S" TextDecorations="Strikethrough"/>
                        </ToggleButton>
                        <Border Style="{StaticResource Separator}"/>

                        <Button x:Name="FontColorBtn" Style="{StaticResource ToolButton}" Click="FontColor_Click" ToolTip="{DynamicResource S.FontColor}" Padding="4,0">
                            <Grid Width="20">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                <Rectangle x:Name="FontColorBar" Height="4" VerticalAlignment="Bottom" Fill="#D64545" RadiusX="1" RadiusY="1"/>
                            </Grid>
                        </Button>
                        <Button x:Name="HighlightBtn" Style="{StaticResource ToolButton}" Click="Highlight_Click" ToolTip="{DynamicResource S.Highlight}" Padding="4,0">
                            <Grid Width="20">
                                <TextBlock Text="&#xE7E6;" Style="{StaticResource Icon}" FontSize="14" Margin="0,-3,0,0"/>
                                <Rectangle x:Name="HighlightBar" Height="4" VerticalAlignment="Bottom" Fill="#FFF176" RadiusX="1" RadiusY="1"/>
                            </Grid>
                        </Button>
                        <Border Style="{StaticResource Separator}"/>

                        <ToggleButton x:Name="AlignLeftBtn" Style="{StaticResource ToolToggle}" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.AlignLeft}">
                            <Path Data="{StaticResource G.AlignLeft}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignCenterBtn" Style="{StaticResource ToolToggle}" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.AlignCenter}">
                            <Path Data="{StaticResource G.AlignCenter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignRightBtn" Style="{StaticResource ToolToggle}" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.AlignRight}">
                            <Path Data="{StaticResource G.AlignRight}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton x:Name="JustifyBtn" Style="{StaticResource ToolToggle}" Command="EditingCommands.AlignJustify" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Justify}">
                            <Path Data="{StaticResource G.Justify}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="16" Height="16"/>
                        </ToggleButton>
                        <Border Style="{StaticResource Separator}"/>

                        <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Bullets}">
                            <Path Data="{StaticResource G.Bullets}" Fill="{StaticResource Ink}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Numbering}" FontSize="12" FontWeight="SemiBold" Content="1."/>
                        <Button Style="{StaticResource ToolButton}" Command="EditingCommands.DecreaseIndentation" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Outdent}">
                            <Path Data="{StaticResource G.Outdent}" Fill="{StaticResource Ink}" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="EditingCommands.IncreaseIndentation" CommandTarget="{Binding ElementName=Editor}" ToolTip="{DynamicResource S.Indent}">
                            <Path Data="{StaticResource G.Indent}" Fill="{StaticResource Ink}" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="LineSpacingBtn" Style="{StaticResource ToolButton}" Click="LineSpacing_Click" ToolTip="{DynamicResource S.LineSpacing}">
                            <Path Data="{StaticResource G.LineSpacing}" Fill="{StaticResource Ink}" Width="16" Height="16"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="1.0" Tag="1.0" Click="LineSpacingItem_Click"/>
                                    <MenuItem Header="1.15" Tag="1.15" Click="LineSpacingItem_Click"/>
                                    <MenuItem Header="1.5" Tag="1.5" Click="LineSpacingItem_Click"/>
                                    <MenuItem Header="2.0" Tag="2.0" Click="LineSpacingItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Border Style="{StaticResource Separator}"/>

                        <Button Style="{StaticResource ToolButton}" Command="{x:Static views:AppCommands.InsertLink}" ToolTip="{DynamicResource S.Link}">
                            <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="ClearFormat_Click" ToolTip="{DynamicResource S.ClearFormat}">
                            <TextBlock Text="&#xE894;" Style="{StaticResource Icon}"/>
                        </Button>
                        <Border Style="{StaticResource Separator}"/>

                        <Button x:Name="PaperBtn" Style="{StaticResource ToolButton}" Click="Paper_Click" ToolTip="{DynamicResource S.Paper}" Padding="6,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PaperSwatch" Width="15" Height="17" CornerRadius="2" BorderBrush="#8A96A8" BorderThickness="1" Background="#FFFDF5" Margin="0,0,6,0">
                                    <StackPanel VerticalAlignment="Center" Margin="3,0">
                                        <Rectangle Height="1" Fill="#8A96A8" Opacity="0.7" Margin="0,1"/>
                                        <Rectangle Height="1" Fill="#8A96A8" Opacity="0.7" Margin="0,1"/>
                                        <Rectangle Height="1" Fill="#8A96A8" Opacity="0.7" Margin="0,1,3,1"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource S.Paper}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- status bar -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,4">
                    <DockPanel>
                        <TextBlock x:Name="SaveStatus" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="LinkHint" DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="0,0,16,0" Text="{DynamicResource S.LinkHint}" Visibility="Collapsed"/>
                        <TextBlock x:Name="WordCount" Style="{StaticResource Caption}"/>
                    </DockPanel>
                </Border>

                <!-- paper -->
                <Grid Margin="18,14,18,12">
                    <Border x:Name="PaperBorder" Background="#FFFDF5" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="10" ClipToBounds="True" Margin="1">
                        <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="40,30,40,60" AcceptsTab="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" IsDocumentEnabled="True" SpellCheck.IsEnabled="False" IsInactiveSelectionHighlightEnabled="True"
                                     TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" PreviewKeyDown="Editor_PreviewKeyDown"
                                     ContextMenuOpening="Editor_ContextMenuOpening" PreviewMouseMove="Editor_PreviewMouseMove" PreviewMouseLeftButtonDown="Editor_PreviewMouseLeftButtonDown"
                                     Drop="Editor_Drop" PreviewDragOver="Editor_PreviewDragOver">
                            <RichTextBox.Resources>
                                <Style TargetType="Hyperlink" BasedOn="{StaticResource RtbHyperlink}"/>
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                                <Style TargetType="List">
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- ================================================= claude panel -->
        <Border x:Name="ClaudePanel" Grid.Column="4" Width="400" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
                DataContext="{Binding Claude}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,12,10,10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="CloseClaude_Click" ToolTip="{DynamicResource S.Close}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding ClearCommand}" ToolTip="{DynamicResource S.Claude.Clear}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource S.Claude.Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource S.Claude.Subtitle}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                            <TextBlock Margin="0,6,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                <Hyperlink Click="ClaudeAccount_Click" Foreground="{StaticResource Accent}" TextDecorations="{x:Null}">
                                    <Run Text="&#xE77B;" FontFamily="{StaticResource IconFont}"/>
                                    <Run Text="{Binding AccountLabel, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                <Hyperlink Click="ClaudeWeb_Click" Foreground="{StaticResource Accent}" TextDecorations="{x:Null}" ToolTip="{DynamicResource S.ClaudeWeb.OpenHint}">
                                    <Run Text="&#xE774;" FontFamily="{StaticResource IconFont}"/>
                                    <Run Text="{DynamicResource S.ClaudeWeb.Open}"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Padding="16,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceAlt}">
                    <DockPanel>
                        <TextBlock Text="{DynamicResource S.Claude.Scope}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ScopeCombo" SelectedIndex="{Binding ScopeIndex}"/>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="12,8,12,12" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource ChipButton}" Content="{DynamicResource S.Claude.P.Today}" Command="{Binding PresetCommand}" CommandParameter="today" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                            <Button Style="{StaticResource ChipButton}" Content="{DynamicResource S.Claude.P.Week}" Command="{Binding PresetCommand}" CommandParameter="week" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                            <Button Style="{StaticResource ChipButton}" Content="{DynamicResource S.Claude.P.Open}" Command="{Binding PresetCommand}" CommandParameter="open" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                            <Button Style="{StaticResource ChipButton}" Content="{DynamicResource S.Claude.P.Next}" Command="{Binding PresetCommand}" CommandParameter="next" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                            <Button Style="{StaticResource ChipButton}" Content="{DynamicResource S.Claude.P.Entry}" Command="{Binding PresetCommand}" CommandParameter="entry" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                        </WrapPanel>
                        <DockPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="2,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Content="{DynamicResource S.Claude.Stop}" Command="{Binding StopCommand}"/>
                            <ProgressBar IsIndeterminate="True" Height="4" Width="60" VerticalAlignment="Center" Margin="0,0,8,0" BorderThickness="0" Foreground="{StaticResource Accent}" Background="{StaticResource Line}"/>
                            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="36" Height="36" Padding="0" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Command="{Binding SendCommand}" ToolTip="{DynamicResource S.Claude.Send}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" FontSize="15"/>
                            </Button>
                            <TextBox x:Name="ClaudeInput" Style="{StaticResource InputBox}" Tag="{DynamicResource S.Claude.InputPlaceholder}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="36" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="ClaudeInput_PreviewKeyDown"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="14,12,14,4" Background="{StaticResource SurfaceAlt}">
                    <StackPanel>
                        <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="{Binding Messages.Count, Converter={StaticResource ZeroToVis}}">
                            <TextBlock Text="{DynamicResource S.Claude.Welcome}" TextWrapping="Wrap" Foreground="{StaticResource Ink}" FontSize="12.5" LineHeight="19"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- popups -->
        <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom">
            <controls:ColorPalette x:Name="ColorPaletteCtl" Margin="8" ColorPicked="ColorPalette_ColorPicked"/>
        </Popup>
        <Popup x:Name="PaperPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom" PlacementTarget="{Binding ElementName=PaperBtn}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8" Margin="8" Padding="12" Width="260">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.PaperColor}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    <controls:ColorPalette x:Name="PaperPalette" Width="Auto" ColorPicked="PaperPalette_ColorPicked"/>
                    <TextBlock Text="{DynamicResource S.PaperStyle}" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                    <Border Background="{StaticResource Line}" CornerRadius="8" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PaperPlain" Style="{StaticResource Segment}" Content="{DynamicResource S.PaperStyle.Plain}" Tag="Plain" Checked="PaperStyle_Checked"/>
                            <RadioButton x:Name="PaperLined" Style="{StaticResource Segment}" Content="{DynamicResource S.PaperStyle.Lined}" Tag="Lined" Checked="PaperStyle_Checked"/>
                            <RadioButton x:Name="PaperGrid" Style="{StaticResource Segment}" Content="{DynamicResource S.PaperStyle.Grid}" Tag="Grid" Checked="PaperStyle_Checked"/>
                            <RadioButton x:Name="PaperDots" Style="{StaticResource Segment}" Content="{DynamicResource S.PaperStyle.Dots}" Tag="Dots" Checked="PaperStyle_Checked"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.PaperDefault}" Click="PaperDefault_Click" Margin="0,12,0,0" Height="28"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
