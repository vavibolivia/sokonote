<Window x:Class="SokoNote.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Settings.Title}" Width="620" Height="700" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource CanvasBg}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Cancel}" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.Save}" IsDefault="True" MinWidth="90" Click="Save_Click"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,4">
            <StackPanel>
                <!-- general -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Settings.General}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource S.Settings.Language}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="LanguageBox">
                            <ComboBoxItem Content="{DynamicResource S.Settings.Lang.Auto}" Tag="auto"/>
                            <ComboBoxItem Content="{DynamicResource S.Settings.Lang.Ko}" Tag="ko"/>
                            <ComboBoxItem Content="{DynamicResource S.Settings.Lang.En}" Tag="en"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource S.Settings.LangRestart}" Style="{StaticResource Hint}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Settings.DefaultFont}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="FontBox" IsEditable="True">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource S.Settings.DefaultFontSize}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="FontSizeBox" IsEditable="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- claude -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Settings.ClaudeSection}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource S.Settings.ClaudeHelp}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>

                        <TextBlock Text="{DynamicResource S.Settings.Email}" Style="{StaticResource Label}"/>
                        <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}" Tag="{DynamicResource S.Settings.EmailPlaceholder}"/>

                        <TextBlock Text="{DynamicResource S.Settings.Mode}" Style="{StaticResource Label}"/>
                        <RadioButton x:Name="ModeSubscription" Content="{DynamicResource S.Settings.ModeSubscription}" GroupName="mode" IsChecked="True" Margin="0,2" Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeApiKey" Content="{DynamicResource S.Settings.ModeApiKey}" GroupName="mode" Margin="0,2" Checked="Mode_Changed"/>

                        <StackPanel x:Name="SubscriptionPanel" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Settings.Login}" Click="Login_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Settings.CheckStatus}" Click="Check_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource S.Settings.LoginHint}" Style="{StaticResource Hint}"/>
                        </StackPanel>

                        <StackPanel x:Name="ApiKeyPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource S.Settings.ApiKey}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="ApiKeyBox"/>
                            <TextBlock Text="{DynamicResource S.Settings.ApiKeyHint}" Style="{StaticResource Hint}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Settings.CheckStatus}" Click="Check_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>

                        <Border x:Name="StatusBorder" Background="{StaticResource SurfaceAlt}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource InkMuted}" Text="—"/>
                        </Border>

                        <TextBlock Text="{DynamicResource S.Settings.CliPath}" Style="{StaticResource Label}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Settings.Browse}" Click="Browse_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="CliPathBox" Style="{StaticResource InputBox}" Tag="{DynamicResource S.Settings.CliAuto}"/>
                        </DockPanel>
                        <TextBlock x:Name="CliDetected" Style="{StaticResource Hint}"/>
                        <TextBlock Style="{StaticResource Hint}">
                            <Hyperlink NavigateUri="https://docs.claude.com/en/docs/claude-code/setup" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="{DynamicResource S.Settings.InstallCli}"/>
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Text="{DynamicResource S.Settings.Model}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ModelBox" IsEditable="True">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="sonnet"/>
                            <ComboBoxItem Content="opus"/>
                            <ComboBoxItem Content="haiku"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- data -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Settings.Data}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource S.Settings.DbPath}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DbPathBox" Style="{StaticResource InputBox}" IsReadOnly="True" Background="{StaticResource SurfaceAlt}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Settings.BackupNow}" Click="Backup_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Settings.OpenFolder}" Click="OpenFolder_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="BackupInfo" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>

                <!-- about -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Settings.About}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" Margin="0"/>
                        <TextBlock Text="{DynamicResource S.Settings.Shortcuts}" Style="{StaticResource Label}"/>
                        <TextBlock Text="{DynamicResource S.Settings.ShortcutsText}" Style="{StaticResource Hint}" Margin="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
