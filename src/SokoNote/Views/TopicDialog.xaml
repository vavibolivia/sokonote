<Window x:Class="SokoNote.Views.TopicDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.TopicDialogNew}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="{DynamicResource S.TopicName}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Tag="{DynamicResource S.TopicNamePlaceholder}" MaxLength="100"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12" Margin="2,4,0,0" Visibility="Collapsed"
                   Text="{DynamicResource S.TopicNameRequired}"/>

        <TextBlock Text="{DynamicResource S.TopicKind}" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="KindJournal" GroupName="kind" Content="{DynamicResource S.TopicKindJournal}" IsChecked="True" Margin="0,0,16,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="KindInfo" GroupName="kind" Content="{DynamicResource S.TopicKindInfo}" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource S.TopicKindHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock Text="{DynamicResource S.TopicColor}" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
        <ItemsControl x:Name="Swatches">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="color" Tag="{Binding}" Checked="Swatch_Checked" Margin="3" Cursor="Hand" Focusable="False">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid Width="30" Height="30">
                                    <Ellipse Fill="{Binding Converter={StaticResource HexToBrush}}"/>
                                    <Ellipse x:Name="ring" Stroke="{StaticResource Ink}" StrokeThickness="2.5" Margin="-3" Visibility="Collapsed"/>
                                    <TextBlock x:Name="check" Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Visibility="Collapsed"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Cancel}" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.OK}" IsDefault="True" MinWidth="80" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
